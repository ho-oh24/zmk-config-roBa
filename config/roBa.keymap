#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/modifiers.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 38>;
            timeout-ms = <100>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <4 38>;
            timeout-ms = <100>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
            timeout-ms = <100>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
            timeout-ms = <100>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        ime_off {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <23 24>;
        };

        ime_on {
            bindings = <&kp INT_HENKAN>;
            key-positions = <31 32>;
        };

        bs_word {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <26 37>;
        };

        flow_launcher {
            bindings = <&kp F20>;
            key-positions = <37 41>;
        };

        kill_left {
            bindings = <&kill_left_macro>;
            key-positions = <10 37>;
        };

        kill_right {
            bindings = <&kill_right_macro>;
            key-positions = <21 37>;
        };

        kill_all {
            bindings = <&kill_all_macro>;
            key-positions = <9 37>;
        };

        bs2 {
            bindings = <&bs2_macro>;
            key-positions = <11 37>;
        };

        bs3 {
            bindings = <&bs3_macro>;
            key-positions = <12 37>;
        };

        bs4 {
            bindings = <&bs4_macro>;
            key-positions = <13 37>;
        };

        bs5 {
            bindings = <&bs5_macro>;
            key-positions = <14 37>;
        };

        bs6 {
            bindings = <&bs6_macro>;
            key-positions = <17 37>;
        };

        bs7 {
            bindings = <&bs7_macro>;
            key-positions = <18 37>;
        };

        bs8 {
            bindings = <&bs8_macro>;
            key-positions = <19 37>;
        };

        bs9 {
            bindings = <&bs9_macro>;
            key-positions = <20 37>;
        };

        del1 {
            bindings = <&kp DELETE>;
            key-positions = <0 37>;
        };

        del2 {
            bindings = <&del2_macro>;
            key-positions = <1 37>;
        };

        del3 {
            bindings = <&del3_macro>;
            key-positions = <2 37>;
        };

        del4 {
            bindings = <&del4_macro>;
            key-positions = <3 37>;
        };

        del5 {
            bindings = <&del5_macro>;
            key-positions = <4 37>;
        };

        del6 {
            bindings = <&del6_macro>;
            key-positions = <5 37>;
        };

        del7 {
            bindings = <&del7_macro>;
            key-positions = <6 37>;
        };

        del8 {
            bindings = <&del8_macro>;
            key-positions = <7 37>;
        };

        del9 {
            bindings = <&del9_macro>;
            key-positions = <8 37>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        kill_left_macro: kill_left_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(HOME)>, <&kp BACKSPACE>;
        };

        kill_right_macro: kill_right_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(END)>, <&kp BACKSPACE>;
        };

        kill_all_macro: kill_all_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME>, <&kp LS(END)>, <&kp BACKSPACE>;
        };

        bs2_macro: bs2_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs3_macro: bs3_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs4_macro: bs4_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs5_macro: bs5_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs6_macro: bs6_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs7_macro: bs7_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs8_macro: bs8_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        bs9_macro: bs9_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>, <&kp BACKSPACE>;
        };

        del2_macro: del2_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>;
        };

        del3_macro: del3_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };

        del4_macro: del4_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };

        del5_macro: del5_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };

        del6_macro: del6_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };

        del7_macro: del7_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };

        del8_macro: del8_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };

        del9_macro: del9_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>, <&kp DELETE>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        comma_shift_morph: comma_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SLASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_shift_morph: dot_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp NUMBER_1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quot_shift_morph: quot_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp SEMICOLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        minus_shift_morph: minus_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        slash_shift_morph: slash_shift_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp INT1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mt_minus_morph: mt_minus_morph {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_MINUS_MORPH";
            bindings = <&kp>, <&minus_shift_morph>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        lt_slash_morph: lt_slash_morph {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SLASH_MORPH";
            bindings = <&mo>, <&slash_shift_morph>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                &kp X          &kp U          &comma_shift_morph      &dot_shift_morph                                                            &kp F           &kp Z           &kp R           &kp Y          &kp P
&mt RIGHT_CONTROL E   &mt LEFT_ALT I &mt LEFT_CONTROL A  &mt LEFT_SHIFT O  &mt_minus_morph LEFT_WIN 0  &none                    &none  &mt LEFT_WIN K  &mt LEFT_SHIFT T  &mt LEFT_CONTROL N  &mt LEFT_ALT S  &mt RIGHT_CONTROL H
&kp J                &kp L          &kp C          &kp V          &quot_shift_morph        &none                       &none  &kp G           &kp D           &kp M           &kp W          &kp B
&kp LEFT_WIN         &kp ESCAPE  &lt_slash_morph 3 0  &lt 1 BACKSPACE  &kp SPACE  &lt_to_layer_0 6 INT_HENKAN      &kp INT_HENKAN  &lt 2 ENTER                        &kp DELETE
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NAV {
            bindings = <
&kp LC(LS(Z))  &kp HOME       &kp UP_ARROW   &kp END        &kp PAGE_UP                                            &kp HASH           &kp RIGHT_BRACKET  &kp BACKSLASH  &kp AT_SIGN     &kp GRAVE
&mt LEFT_SHIFT KP_MINUS  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_PLUS  &trans      &trans  &kp LEFT_BRACKET  &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp AMPERSAND  &kp DOLLAR
&kp LC(Z)      &kp LC(X)      &kp LC(C)      &kp LC(V)      &kp PAGE_DOWN  &trans                  &trans  &kp PERCENT       &kp RIGHT_BRACE    &kp PIPE       &kp LEFT_BRACE  &kp CARET
&trans         &trans         &trans         &trans         &trans         &kp INT1               &trans          &trans                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        FN_NUM {
            bindings = <
&kp F1   &kp F2  &kp F3  &kp F4  &kp F5                                                    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans      &trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LESS_THAN  &kp EQUAL  &kp GREATER_THAN  &kp LS(INT1)  &kp HASH  &trans      &trans  &kp LEFT_BRACKET  &kp KP_PLUS  &kp KP_MINUS  &kp KP_MULTIPLY  &kp EQUAL
&trans   &trans          &trans          &trans            &trans             &trans        &trans         &trans                              &trans
            >;
        };

        NUMPAD_MEDIA {
            bindings = <
&kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS                                                  &trans              &kp INSERT       &kp PAUSE_BREAK  &kp PRINTSCREEN  &trans
&kp KP_N0  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_DOT  &trans      &trans  &kp C_VOLUME_UP   &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT        &trans
&kp KP_DIVIDE  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_MINUS  &trans      &trans  &kp C_VOLUME_DOWN  &kp CAPSLOCK     &trans             &kp KP_NUMLOCK  &trans
&trans           &trans     &trans     &trans     &trans     &trans          &trans            &trans                                                    &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &mkp MB4  &mkp MB3    &mkp MB5    &kp LEFT_SHIFT
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB1  &mkp MB2    &mo 5    &trans  &kp RIGHT_CONTROL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
